{
  "realm": "sp2-local",
  "displayName": "SnackPortal2 local development",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "name": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"unmanagedAttributePolicy\": \"ENABLED\", \"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "sp2-principal",
      "description": "SnackPortal2 principal claims: subject, BFF audience, PlatformRole.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sp2-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "sp2-bff-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "snackportal2-bff",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "sp2-platform-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "sp2_role",
            "claim.name": "role",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "sp2:tenant:acme",
      "description": "Tenant-scoped SnackPortal2 access token for tenant acme.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sp2-active-tenant-acme",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "active_tenant",
            "claim.value": "acme",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "sp2-tenant-claim-acme",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant",
            "claim.value": "acme",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "sp2:tenant:zeta",
      "description": "Tenant-scoped SnackPortal2 access token for tenant zeta.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sp2-active-tenant-zeta",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "active_tenant",
            "claim.value": "zeta",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "sp2-tenant-claim-zeta",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant",
            "claim.value": "zeta",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "sp2:tenant:nova",
      "description": "Tenant-scoped SnackPortal2 access token for tenant nova.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sp2-active-tenant-nova",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "active_tenant",
            "claim.value": "nova",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "sp2-tenant-claim-nova",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant",
            "claim.value": "nova",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "sp2-local-web",
      "name": "SnackPortal2 local browser client",
      "description": "Public browser client. Authorization Code + PKCE S256 only; there is no client secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:5173/sp2-gateway/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/sp2-gateway"
      },
      "defaultClientScopes": [
        "sp2-principal"
      ],
      "optionalClientScopes": [
        "sp2:tenant:acme",
        "sp2:tenant:zeta",
        "sp2:tenant:nova"
      ]
    }
  ],
  "users": [
    {
      "id": "local-agent-acme",
      "username": "acme-agent",
      "enabled": true,
      "emailVerified": false,
      "requiredActions": [],
      "attributes": {
        "sp2_role": [
          "TENANT_AGENT"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "__SP2_LOCAL_IDP_PASSWORD_ACME__",
          "temporary": false
        }
      ]
    },
    {
      "id": "local-agent-zeta",
      "username": "zeta-agent",
      "enabled": true,
      "emailVerified": false,
      "requiredActions": [],
      "attributes": {
        "sp2_role": [
          "TENANT_AGENT"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "__SP2_LOCAL_IDP_PASSWORD_ZETA__",
          "temporary": false
        }
      ]
    },
    {
      "id": "local-agent-nova",
      "username": "nova-agent",
      "enabled": true,
      "emailVerified": false,
      "requiredActions": [],
      "attributes": {
        "sp2_role": [
          "TENANT_AGENT"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "__SP2_LOCAL_IDP_PASSWORD_NOVA__",
          "temporary": false
        }
      ]
    },
    {
      "id": "local-operator-control",
      "username": "control-operator",
      "enabled": true,
      "emailVerified": false,
      "requiredActions": [],
      "attributes": {
        "sp2_role": [
          "CONTROL"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "__SP2_LOCAL_IDP_PASSWORD_CONTROL__",
          "temporary": false
        }
      ]
    }
  ]
}
