# PRD 06 B-3A — keep local runtime secrets/state OUT of git (D-14).
# The committed templates are the ONLY env files in git; real local env files are never committed.

.env.local
.env.rebuild
.env.*
!.env.local.template
!.env.rebuild.template
.runtime/
*.log

# Stage 6A — the local Keycloak realm. The committed artefact is the TEMPLATE, which carries
# password placeholders; `sp2_local init-env` renders the real file into keycloak/import/ with
# generated local throwaway passwords, and that directory is what the container mounts.
keycloak/import/
