# SnackPortal2 — Option A rebuild (D-46) — LOCAL environment template.
# COMMITTED, and therefore PLACEHOLDER-ONLY: every secret line below is deliberately EMPTY.
#
# ---------------------------------------------------------------------------------------------
# HOW TO USE THIS FILE
#
# Do not fill it in by hand. Generate a filled, untracked copy with fresh random values:
#
#     cd backend
#     python -m tools.local.sp2_local init-env
#
# which writes ../infrastructure/docker/.env.rebuild (gitignored) and never overwrites an
# existing one unless you pass --force. Then:
#
#     docker compose -f infrastructure/docker/docker-compose.rebuild.yml \
#                    --env-file infrastructure/docker/.env.rebuild up -d --wait
#
# See docs/Local_Development_Runbook.md for the full procedure.
#
# ---------------------------------------------------------------------------------------------
# WHY THE SECRET LINES ARE EMPTY RATHER THAN "replace-me-..."
#
# A placeholder long enough to satisfy a length rule is a placeholder that WORKS. The lineage
# chain keys need 32 characters, so any example long enough to be copy-pasteable would also be
# long enough to be left in place — and every developer's local chain would then be keyed with a
# value that is in the repository. Empty instead: the compose file's `${VAR:?...}` guards fail
# the launch with a named variable, so a missing value is a loud, immediate, obvious failure.
#
# NOTHING HERE IS A PRODUCTION SECRET, and nothing here is a production configuration. Every
# value is a local throwaway for a disposable stack.
# ---------------------------------------------------------------------------------------------


# =============================================================================================
# 1. LOCAL POSTGRESQL — the four physically separate clusters
# =============================================================================================
# LOCAL DEV ONLY. Four separate clusters, published on loopback so host-side tooling (the
# migration command, psql, the live-PostgreSQL test suites) can reach them. The services reach
# them by container-network DNS instead, so these ports are for you, not for them.
#
#   control-postgres  127.0.0.1:5550  snackportal2_control
#   acme-postgres     127.0.0.1:5551  snackportal2_tenant_acme
#   zeta-postgres     127.0.0.1:5552  snackportal2_tenant_zeta
#   nova-postgres     127.0.0.1:5553  snackportal2_tenant_nova
#
# 5550-5553 rather than 5540-5543 so this stack can run alongside the standing
# docker-compose.local.yml fixture without a port collision.

# Container superuser name. NOT a secret. Required (a default of sp2_local applies if empty).
SP2_LOCAL_PG_USER=sp2_local

# Container superuser password. REQUIRED, SECRET, and a LOCAL THROWAWAY — never a real one.
# Empty here on purpose; the compose file refuses to start without it.
SP2_LOCAL_PG_PASSWORD=

# Host-side connection details, used by the migration/seed command and by nothing else.
# NOT secret. Change these only if you also change the published ports in the compose file.
SP2_LOCAL_PG_HOST=127.0.0.1
SP2_LOCAL_PG_PORT_CONTROL=5550
SP2_LOCAL_PG_PORT_ACME=5551
SP2_LOCAL_PG_PORT_ZETA=5552
SP2_LOCAL_PG_PORT_NOVA=5553


# =============================================================================================
# 2. STORAGE SELECTOR
# =============================================================================================
# The ONLY accepted value is the exact string `postgres` (case-insensitive). Anything else —
# including a typo — selects in-memory storage, which is why this is explicit rather than
# inferred: a silent fallback from PostgreSQL to in-memory turns a database outage into
# apparently-successful reads of an empty tenant.
#
# Required for a real local launch. LOCAL DEV convenience: set it to `memory` to run the service
# topology with no database at all.
SP2_TENANT_STORAGE=postgres


# =============================================================================================
# 3. INTERNAL SERVICE CREDENTIALS
# =============================================================================================
# SECRET. All REQUIRED. Local throwaways.
#
# Internal surfaces are never client-reachable (IC-013 §13); these are a second, independent
# control so that a misconfigured network boundary alone is not sufficient to reach one.
#
# Two important properties of the value split below:
#
#   * The BFF's credential is separate from every tenant-resident service's credential, because
#     the BFF is permanently OFF the Database Router's grant allowlist (D-48 C-1). Giving it a
#     value that appears in the allowlist would hand the public ingress a route to a tenant
#     connection, which is the exact thing the exclusion exists to prevent.
#   * Each tenant-resident service holds its OWN credential. The allowlist maps credential ->
#     service reference, so one shared value would let any process holding it request a grant as
#     any granted service — an allowlist of names rather than a control.
#
# The shared internal credential: presented by the BFF to every service it calls, by Access
# Control to the Control Plane, and by the Database Router to the Control Plane. It is NOT a
# grantee and must never appear in the router's allowlist.
SP2_INTERNAL_SERVICE_CREDENTIAL=

# One per tenant-resident service. Each of these five appears in SP2_DATABASE_ROUTER_GRANTEES
# (assembled inside the compose file) mapped to exactly that service.
SP2_STARTUPS_SERVICE_CREDENTIAL=
SP2_INVESTORS_SERVICE_CREDENTIAL=
SP2_DEALS_SERVICE_CREDENTIAL=
SP2_LINEAGE_SERVICE_CREDENTIAL=
SP2_IMPORT_SERVICE_SERVICE_CREDENTIAL=


# =============================================================================================
# 4. AUTHENTICATION
# =============================================================================================
# The Authentication Service (IC-005) chooses its verifier from explicit configuration, with a
# hard precedence and a fail-closed default:
#
#     SP2_AUTHENTICATION_ISSUERS set   -> real JWT verification against pinned issuers
#     else STATIC principals set       -> opaque local development tokens
#     else                             -> deny-all: the service is healthy and authenticates nobody
#
# PRODUCTION posture. Leave EMPTY for local development. A JSON object keyed by the exact `iss`
# claim: {"<issuer>": {"audience": "...", "algorithms": ["RS256"], "public_key_pem": "..."}}.
# Asymmetric algorithms only — a symmetric one is rejected at configuration time, because a
# verifier holding a key capable of minting tokens can forge any principal.
# Setting this WINS over the local tokens below, so a stray development value in a production
# environment cannot widen the trust surface.
SP2_AUTHENTICATION_ISSUERS=

# LOCAL DEV ONLY. SECRET. REQUIRED for a local launch that can authenticate anybody.
#
# These four opaque tokens are assembled by the compose file into the StaticTokenVerifier map.
# StaticTokenVerifier is a SUPPORTED verifier that already existed in the Authentication Service
# — this configures it; it is not a new authentication mechanism and it is not a bypass. It is
# never selected by omission, and setting it is a deliberate choice of a development posture.
#
# Each token binds to one synthetic local principal:
#
#   SP2_LOCAL_TOKEN_ACME_AGENT  -> local-agent-acme    TENANT_AGENT   active tenant: acme
#   SP2_LOCAL_TOKEN_ZETA_AGENT  -> local-agent-zeta    TENANT_AGENT   active tenant: zeta
#   SP2_LOCAL_TOKEN_NOVA_AGENT  -> local-agent-nova    TENANT_AGENT   active tenant: nova
#   SP2_LOCAL_TOKEN_CONTROL     -> local-operator-control  CONTROL    active tenant: none
#
# The active tenant is the SIGNED CLAIM and the sole routing authority. There is no request
# parameter through which a caller can name a different one. The ACME token can therefore never
# read a ZETA record — which is what the local isolation check exercises.
SP2_LOCAL_TOKEN_ACME_AGENT=
SP2_LOCAL_TOKEN_ZETA_AGENT=
SP2_LOCAL_TOKEN_NOVA_AGENT=
SP2_LOCAL_TOKEN_CONTROL=


# =============================================================================================
# 5. PER-TENANT LINEAGE CHAIN KEYS (D-23)
# =============================================================================================
# SECRET. REQUIRED (the Import Service is the only consumer). MINIMUM 32 CHARACTERS.
#
# A D-23 integrity marker is a keyed HMAC and the key is per tenant. There is no default key, no
# shared fallback and no placeholder: a single fallback would make every tenant's chain
# verifiable with one secret, which is the opposite of a per-tenant chain. A tenant whose key is
# absent, empty or shorter than 32 characters cannot be imported into at all — the write fails
# closed rather than storing a tenant record without provenance.
#
# The 32-character floor is configuration validation, not cryptographic policy: HMAC accepts a
# key of any length and reports nothing about its quality, so "x" would produce a perfectly
# well-formed marker that proves nothing.
#
# KEY ROTATION IS NOT DESIGNED (Action Tracker; explicitly out of Stage 6 scope). Changing a key
# INVALIDATES verification of every lineage row already written under the previous one. For a
# disposable local stack that is fine — reset the databases as well.
SP2_LINEAGE_KEY_ACME=
SP2_LINEAGE_KEY_ZETA=
SP2_LINEAGE_KEY_NOVA=


# =============================================================================================
# 6. BFF INGRESS
# =============================================================================================
# The BFF is the only public application ingress (E-1). It is published on 127.0.0.1:8000 by the
# compose file; that mapping lives there because publishing is a deployment decision.
#
# Host-based tenant addressing. OPTIONAL, NOT secret, and EMPTY for local development. With no
# base domain configured, the tenant subdomain carrier is OFF entirely and `X-Tenant-Id` is the
# only recognized carrier — which is what stops `localhost` being read as a tenant label.
# A carrier is match-or-reject only: it never grants tenant access and never selects a database.
SP2_BFF_BASE_DOMAIN=

# CORS: no CORS middleware exists in the rebuild, and Stage 6 does not add one. The local
# frontend reaches the BFF through its dev-server proxy (same origin), so no cross-origin
# request is made. Adding CORS is a contract decision about the public ingress, not a local
# launch convenience.


# =============================================================================================
# 7. OPTIONAL TUNING
# =============================================================================================
# NOT secret. Omit for the secure default in every case.
#
# How long any service may spend opening a PostgreSQL connection, in seconds. Default 4,
# deliberately shorter than the BFF's own 5-second downstream timeout so a request that fails
# fails with an answer rather than a hang. An unparseable or non-positive value takes the default
# rather than disabling the bound.
# SP2_DB_CONNECT_TIMEOUT_SECONDS=4
