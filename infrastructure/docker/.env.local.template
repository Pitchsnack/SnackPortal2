# SnackPortal2 — PRD 06 B-3A — LOCAL env template (COMMITTED: placeholders + references only).
#
# Copy this file to `.env.local` (untracked, gitignored) and set a THROWAWAY LOCAL value for the password line.
# NO real secret value may appear in this committed template (D-14). The real local password lives ONLY in the
# untracked .env.local and is never committed, staged, or printed.
#
#   cp infrastructure/docker/.env.local.template infrastructure/docker/.env.local
#   # then edit .env.local and set SP2_LOCAL_PG_PASSWORD to a local throwaway value
#   docker compose -f infrastructure/docker/docker-compose.local.yml --env-file infrastructure/docker/.env.local up -d

# Local container superuser name (non-secret).
SP2_LOCAL_PG_USER=sp2_local

# Local container password — LEAVE EMPTY HERE. Set a throwaway value ONLY in the untracked .env.local.
SP2_LOCAL_PG_PASSWORD=

# D-14 secret-store REFERENCES (keys only — never values) for the local Control + tenant DBs.
SP2_LOCAL_CONTROL_DB_REF=ref:local/control-db
SP2_LOCAL_TENANT_ACME_DB_REF=ref:local/tenant/acme-db
SP2_LOCAL_TENANT_ZETA_DB_REF=ref:local/tenant/zeta-db
SP2_LOCAL_TENANT_NOVA_DB_REF=ref:local/tenant/nova-db
