# SnackPortal2 — example environment template (Build Phase 1)
# REFERENCES ONLY. No secret values. Secrets are resolved at runtime via the
# SecretStore port (D-14). Reference format:  KEY=ref:<store-ref>@<version>

# --- Control plane (IC-001 / D-01) ---
CONTROL_DB_DSN_REF=ref:control-db/dsn@1
BOOTSTRAP_TRUST_ANCHOR_REF=ref:bootstrap/trust-anchor@1

# --- OIDC federation (IC-005 / D-03/D-05) — non-secret addressing only ---
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_REF=ref:oidc/jwks@1

# --- Vendor-neutral provider selection (config-driven; adapters live in providers/) ---
SECRETSTORE_PROVIDER=
QUEUE_PROVIDER=
RATELIMITER_PROVIDER=
