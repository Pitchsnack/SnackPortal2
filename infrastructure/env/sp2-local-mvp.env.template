# SnackPortal2 — sp2-local-mvp operator configuration template (SP2-NEXT-A-PORTABILITY O-4)
# REFERENCES ONLY. No secret values, no DSNs, no hosts, no ports (D-14).
# Physical endpoints (hosts/ports) are OPERATOR CONFIGURATION resolved through the
# SecretStore port at composition time; they are never architecture and never identity.
# Reference format:  KEY=ref:<store-ref>@<version>
# Non-secret values (e.g. the artifact root path) are filled per host by the operator
# in an untracked local env file; they never enter business code or this template.

# --- Logical environment identity (identity, not configuration) ---
SP2_PROFILE_ID=sp2-local-mvp
SP2_ENVIRONMENT_ID=SP2-LOCAL-MVP-01

# --- Logical database endpoint references (resolved via SecretStore; D-14) ---
SP2_DB_CONTROL_ENDPOINT_REF=ref:db/control/endpoint@1
SP2_DB_TENANT_ACME_ENDPOINT_REF=ref:db/tenant-acme/endpoint@1
SP2_DB_TENANT_ZETA_ENDPOINT_REF=ref:db/tenant-zeta/endpoint@1
SP2_DB_TENANT_NOVA_ENDPOINT_REF=ref:db/tenant-nova/endpoint@1

# --- Alerting (secret-resolvable destination reference) ---
SP2_ALERT_DESTINATION_REF=ref:alerts/operator@1

# --- Non-secret operator configuration (filled per host; left empty here) ---
SP2_ARTIFACT_ROOT=
SP2_BACKUP_TARGET=

# --- Vendor-neutral provider selection (adapters live under adapters/providers/) ---
SECRETSTORE_PROVIDER=env-reference

# --- Standing local MVP runtime selectors (Gate-A ADDITION; NAMES ONLY) -------------------------
# The process-level selectors the governed standing launcher
# (backend/tools/local/start-sp2-local.ps1) owns, recorded here so the standing posture is
# reviewable in one place. NO PHYSICAL HANDLE APPEARS HERE: hosts and ports are operator
# configuration, not architecture (SP2-NEXT-A-PORTABILITY), and this template carries logical
# references only. The governed standing port map lives in
# docs/runbooks/backend_service_startup_fastapi.md §2.1 and in the launcher itself.
#
# ACTIVATION SELECTORS — deliberately left UNSET, and NOT active defaults. Setting any of them
# produces PERSISTENT STANDING STATE and is Gate-B work:
#   SP2_CP_CONTROL_STORE            -> 'postgres' activates durable Control reads   (Gate-B M12)
#   SP2_GW_AUDIT_SINK_BASE_URL      -> activates durable Gateway audit rows          (Gate-B M11)
#   SP2_GW_TENANT_STARTUP_BASE_URL  -> activates the tenant data plane               (Gate-B M14)
#
# MUST REMAIN UNSET for the controlled local MVP journey (IMPORT-A / D-3):
#   SP2_GW_IMPORT_BASE_URL
#   SP2_IMPORT_AUDIT_SINK_BASE_URL
#   SP2_DBR_ROUTING_AUDIT_BASE_URL
#
# Secret-store REFERENCE names only. The AW-1 writer credential itself lives solely in the
# operator-local untracked mechanism named by
# SNACKPORTAL_SECRET_CONTROL_GATEWAY_AUDIT_WRITER_DSN_V1, and never in any tracked file.
SP2_CP_CONTROL_STORE_DSN_REF=
SP2_GW_AUDIT_WRITER_DSN_REF=ref:control/gateway-audit-writer-dsn@1

# --- Frontend / Gateway shared standing origin (operator-filled; logical here) ------------------
# Backend SP2_GW_EDGE_ALLOWED_ORIGINS and the frontend's VITE_SP2_OIDC_REDIRECT_URI must agree
# byte-for-byte with the live Keycloak client registration. A one-character mismatch produces a
# SILENT browser-side CORS block, not a server error: the preflight answers 204, the browser never
# sends the real request, and nothing appears in any server log.
SP2_GW_EDGE_ALLOWED_ORIGINS=
