# SnackPortal2 — sp2-local-mvp operator configuration template (SP2-NEXT-A-PORTABILITY O-4)
# REFERENCES ONLY. No secret values, no DSNs, no hosts, no ports (D-14).
# Physical endpoints (hosts/ports) are OPERATOR CONFIGURATION resolved through the
# SecretStore port at composition time; they are never architecture and never identity.
# Reference format:  KEY=ref:<store-ref>@<version>
# Non-secret values (e.g. the artifact root path) are filled per host by the operator
# in an untracked local env file; they never enter business code or this template.

# --- Logical environment identity (identity, not configuration) ---
SP2_PROFILE_ID=sp2-local-mvp
SP2_ENVIRONMENT_ID=SP2-LOCAL-MVP-01

# --- Logical database endpoint references (resolved via SecretStore; D-14) ---
SP2_DB_CONTROL_ENDPOINT_REF=ref:db/control/endpoint@1
SP2_DB_TENANT_ACME_ENDPOINT_REF=ref:db/tenant-acme/endpoint@1
SP2_DB_TENANT_ZETA_ENDPOINT_REF=ref:db/tenant-zeta/endpoint@1
SP2_DB_TENANT_NOVA_ENDPOINT_REF=ref:db/tenant-nova/endpoint@1

# --- Alerting (secret-resolvable destination reference) ---
SP2_ALERT_DESTINATION_REF=ref:alerts/operator@1

# --- Non-secret operator configuration (filled per host; left empty here) ---
SP2_ARTIFACT_ROOT=
SP2_BACKUP_TARGET=

# --- Vendor-neutral provider selection (adapters live under adapters/providers/) ---
SECRETSTORE_PROVIDER=env-reference
